@model OnlineRecipeSharing.Models.ViewModels.RecipeViewModel

<div class="recipe-hero" style="@(Model.images != null && Model.images.Any() ? $"background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{Model.images[0]}')" : "background: linear-gradient(135deg, #28a745, #20c997)")">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    <span class="badge badge-custom bg-success">@Model.category</span>
                    @if (Model.tags != null && Model.tags.Any())
                    {
                        @foreach (var tag in Model.tags.Take(3))
                        {
                            <span class="badge badge-custom bg-info">@tag</span>
                        }
                    }
                    @if (Model.status == "private")
                    {
                        <span class="badge badge-custom bg-secondary">
                            <i class="fas fa-lock me-1"></i>Private
                        </span>
                    }
                    @if (Model.status == "deleted")
                    {
                        <span class="badge badge-custom bg-danger">
                            <i class="fas fa-trash me-1"></i>Deleted
                        </span>
                    }
                </div>
                <h1 class="display-4 fw-bold mb-3">@Model.title</h1>
                <p class="lead mb-4">@Model.description</p>

                <!-- Like/Dislike Section -->
                <div class="vote-section mb-3">
                    <div class="btn-group" role="group">
                        <button id="like-btn" class="btn @(Model.UserVote == "like" ? "btn-success" : "btn-outline-success") vote-btn"
                                data-recipe-id="@Model.recipe_id" data-vote-type="like">
                            <i class="fas fa-thumbs-up me-2"></i>
                            <span id="like-count">@Model.LikesCount</span>
                        </button>
                        <button id="dislike-btn" class="btn @(Model.UserVote == "dislike" ? "btn-danger" : "btn-outline-danger") vote-btn"
                                data-recipe-id="@Model.recipe_id" data-vote-type="dislike">
                            <i class="fas fa-thumbs-down me-2"></i>
                            <span id="dislike-count">@Model.DislikesCount</span>
                        </button>
                    </div>
                    <small class="text-muted d-block mt-1">Click to like or dislike this recipe</small>
                </div>

                <div class="d-flex align-items-center text-light">
                    <small class="me-4">
                        <i class="fas fa-user me-1"></i>By @Model.author_username
                    </small>
                    <small class="me-4">
                        <i class="fas fa-calendar me-1"></i>@Model.created_at.ToString("MMMM dd, yyyy")
                    </small>
                    <small>
                        <i class="fas fa-comment me-1"></i>@Model.comments_count comments
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Recipe Images -->
            @if (Model.images != null && Model.images.Any())
            {
                <div class="mb-5">
                    <div class="row g-3">
                        @foreach (var image in Model.images)
                        {
                            <div class="col-md-6">
                                <img src="@image" alt="@Model.title" class="recipe-image w-100">
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Ingredients Section -->
            <div class="mb-5">
                <h3 class="mb-4">
                    <i class="fas fa-shopping-basket text-success me-2"></i>Ingredients
                    <small class="text-muted">(@Model.ingredients.Count items)</small>
                </h3>
                <div class="ingredient-list">
                    @if (Model.ingredients != null && Model.ingredients.Any())
                    {
                        @foreach (var ingredient in Model.ingredients)
                        {
                            <div class="ingredient-item">
                                <i class="fas fa-circle text-success me-3" style="font-size: 0.5rem;"></i>
                                <span>@ingredient</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No ingredients listed.</p>
                    }
                </div>
            </div>

            <!-- Instructions Section -->
            <div class="mb-5">
                <h3 class="mb-4">
                    <i class="fas fa-list-ol text-success me-2"></i>Instructions
                    <small class="text-muted">(@Model.steps.Count steps)</small>
                </h3>
                <div class="ingredient-list">
                    @if (Model.steps != null && Model.steps.Any())
                    {
                        @for (int i = 0; i < Model.steps.Count; i++)
                        {
                            <div class="ingredient-item">
                                <div class="step-number">@(i + 1)</div>
                                <div>
                                    <p class="mb-0">@Model.steps[i]</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No instructions available.</p>
                    }
                </div>
            </div>

            <!-- Comments Section -->
            <div class="mb-5" id="comments-section">
                <h3 class="mb-4">
                    <i class="fas fa-comments text-success me-2"></i>Comments
                    <small class="text-muted">(@Model.Comments.Count)</small>
                </h3>

                <!-- Add Comment Form -->
                @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                {
                    <div class="card mb-4">
                        <div class="card-body">
                            <h6 class="card-title">Add a Comment</h6>
                            <form asp-action="AddComment" method="post" id="commentForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="recipeId" value="@Model.recipe_id" />
                                <div class="mb-3">
                                    <textarea class="form-control" name="commentText" rows="3"
                                          placeholder="Share your thoughts about this recipe..."
                                          maxlength="1000" required></textarea>
                                    <div class="form-text">
                                        <span id="charCount">0</span>/1000 characters
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-paper-plane me-2"></i>Post Comment
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Please <a href="@Url.Action("Login", "Account")" class="alert-link">log in</a> to leave a comment.
                    </div>
                }

                <!-- Comments List -->
                <div class="comments-list">
                    @if (Model.Comments.Any())
                    {
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="card mb-3 comment-card" id="comment-@comment.comment_id">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="card-subtitle mb-1 fw-bold">@comment.AuthorUsername</h6>
                                            <small class="text-muted">@comment.FormattedDate</small>
                                        </div>
                                        @if (comment.CanEdit || comment.CanDelete)
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary border-0" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @if (comment.CanEdit)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item text-primary"
                                                                    onclick="enableEdit('@comment.comment_id', '@comment.Comment.Replace("'", "\\'")')">
                                                                <i class="fas fa-edit me-2"></i>Edit
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (comment.CanDelete)
                                                    {
                                                        <li>
                                                            <form asp-action="DeleteComment" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="commentId" value="@comment.comment_id" />
                                                                <input type="hidden" name="recipeId" value="@Model.recipe_id" />
                                                                <button type="submit" class="dropdown-item text-danger"
                                                                        onclick="return confirm('Are you sure you want to delete this comment?')">
                                                                    <i class="fas fa-trash me-2"></i>Delete
                                                                </button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>

                                    <div class="comment-content">
                                        <p class="card-text mb-0" id="comment-text-@comment.comment_id">@comment.Comment</p>

                                        <!-- Edit Form (Hidden by default) -->
                                        <div class="edit-comment-form" id="edit-form-@comment.comment_id" style="display: none;">
                                            <form asp-action="EditComment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="commentId" value="@comment.comment_id" />
                                                <input type="hidden" name="recipeId" value="@Model.recipe_id" />
                                                <div class="mb-2">
                                                    <textarea class="form-control" name="commentText" rows="3"
                                                      maxlength="1000" required id="edit-textarea-@comment.comment_id"></textarea>
                                                    <div class="form-text">
                                                        <span class="edit-char-count">0</span>/1000 characters
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="fas fa-check me-1"></i>Save
                                                    </button>
                                                    <button type="button" class="btn btn-secondary btn-sm"
                                                            onclick="cancelEdit('@comment.comment_id')">
                                                        <i class="fas fa-times me-1"></i>Cancel
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-comments fa-2x mb-3"></i>
                            <p>No comments yet. Be the first to share your thoughts!</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            @if (Model.IsOwner && Model.status != "deleted")
            {
                <div class="d-flex gap-2 mb-5">
                    <a href="@Url.Action("Edit", "Recipe", new { id = Model.recipe_id })" class="btn btn-success">
                        <i class="fas fa-edit me-2"></i>Edit Recipe
                    </a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="fas fa-trash me-2"></i>Delete Recipe
                    </button>
                </div>
            }
            else if (Model.IsOwner && Model.status == "deleted")
            {
                <div class="alert alert-warning mb-5">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    This recipe has been deleted. It is no longer visible to other users.
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Author Card -->
            <div class="author-card mb-4">
                <h5 class="mb-3">
                    <i class="fas fa-user text-success me-2"></i>About the Chef
                </h5>
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-success d-flex align-items-center justify-content-center me-3"
                         style="width: 50px; height: 50px;">
                        <i class="fas fa-user text-white"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold">@Model.author_username</h6>
                        <small class="text-muted">Recipe Creator</small>
                    </div>
                </div>
                <a href="@Url.Action("View", "Profile", new { username = Model.author_username })" class="btn btn-success w-100">
                    <i class="fas fa-user me-2"></i>View Profile
                </a>
            </div>

            <!-- Recipe Stats -->
            <div class="author-card mb-4">
                <h5 class="mb-3">
                    <i class="fas fa-chart-bar text-success me-2"></i>Recipe Stats
                </h5>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="text-success fw-bold h4 mb-1" id="stats-upvotes">@Model.upvotes</div>
                        <small class="text-muted">Likes</small>
                    </div>
                    <div class="col-4">
                        <div class="text-success fw-bold h4 mb-1">@Model.comments_count</div>
                        <small class="text-muted">Comments</small>
                    </div>
                    <div class="col-4">
                        <div class="text-success fw-bold h4 mb-1">@Model.ingredients?.Count</div>
                        <small class="text-muted">Ingredients</small>
                    </div>
                </div>
            </div>

            <!-- Tags -->
            @if (Model.tags != null && Model.tags.Any())
            {
                <div class="author-card">
                    <h5 class="mb-3">
                        <i class="fas fa-tags text-success me-2"></i>Tags
                    </h5>
                    <div>
                        @foreach (var tag in Model.tags)
                        {
                            <span class="badge bg-light text-dark me-1 mb-1">@tag</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (Model.IsOwner && Model.status != "deleted")
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger" id="deleteModalLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Are you sure you want to delete this recipe?</p>
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> This will mark the recipe as deleted and hide it from other users, but it can be restored later if needed.
                    </div>
                    <ul class="text-muted small">
                        <li>Recipe will be hidden from public view</li>
                        <li>Your images and data will be preserved</li>
                        <li>You can restore the recipe later</li>
                    </ul>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <form asp-action="Delete" asp-controller="Recipe" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.recipe_id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Yes, Delete Recipe
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- AntiForgeryToken for AJAX requests -->
@Html.AntiForgeryToken()

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Vote functionality
        const likeBtn = document.getElementById('like-btn');
        const dislikeBtn = document.getElementById('dislike-btn');

        if (likeBtn) {
            likeBtn.addEventListener('click', function() {
                const recipeId = this.getAttribute('data-recipe-id');
                voteRecipe(recipeId, 'like');
            });
        }

        if (dislikeBtn) {
            dislikeBtn.addEventListener('click', function() {
                const recipeId = this.getAttribute('data-recipe-id');
                voteRecipe(recipeId, 'dislike');
            });
        }

        // Comment form validation
        const commentForm = document.getElementById('commentForm');
        if (commentForm) {
            commentForm.addEventListener('submit', function(e) {
                const commentTextarea = this.querySelector('textarea[name="commentText"]');
                if (commentTextarea && commentTextarea.value.trim().length === 0) {
                    e.preventDefault();
                    alert('Please enter a comment before submitting.');
                    commentTextarea.focus();
                }
            });
        }

        // Character counter for comment textarea
        const commentTextarea = document.querySelector('textarea[name="commentText"]');
        if (commentTextarea) {
            const charCount = document.getElementById('charCount');
            commentTextarea.addEventListener('input', function() {
                charCount.textContent = this.value.length;
            });
        }

        // Image click handlers
        const recipeImages = document.querySelectorAll('.recipe-image');
        recipeImages.forEach((img, index) => {
            img.style.cursor = 'pointer';
            img.addEventListener('click', function() {
                openImageModal(this.src, index);
            });
        });

        // Ingredient check functionality
        const ingredientItems = document.querySelectorAll('.ingredient-item');
        ingredientItems.forEach(item => {
            item.style.cursor = 'pointer';
            item.addEventListener('click', function() {
                this.classList.toggle('ingredient-checked');
            });
        });

        // Print recipe functionality
        const printButton = document.createElement('button');
        printButton.className = 'btn btn-outline-success me-2';
        printButton.innerHTML = '<i class="fas fa-print me-2"></i>Print Recipe';
        printButton.addEventListener('click', function() {
            window.print();
        });

        // Share recipe functionality
        const shareButton = document.createElement('button');
        shareButton.className = 'btn btn-outline-info me-2';
        shareButton.innerHTML = '<i class="fas fa-share-alt me-2"></i>Share';
        shareButton.addEventListener('click', function() {
            if (navigator.share) {
                navigator.share({
                    title: document.title,
                    text: document.querySelector('.lead').textContent,
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    showToast('Recipe link copied to clipboard!', 'success');
                });
            }
        });

        // Add buttons to action section
        const actionSection = document.querySelector('.d-flex.gap-2');
        if (actionSection) {
            actionSection.prepend(shareButton);
            actionSection.prepend(printButton);
        }

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add character counters to all edit textareas
        document.querySelectorAll('.edit-comment-form textarea').forEach(textarea => {
            const charCount = textarea.parentElement.querySelector('.edit-char-count');
            if (charCount) {
                textarea.addEventListener('input', function() {
                    charCount.textContent = this.value.length;
                });
            }
        });

        // Smooth scroll to comment section when URL has #comments hash
        if (window.location.hash === '#comments') {
            const commentsSection = document.getElementById('comments-section');
            if (commentsSection) {
                commentsSection.scrollIntoView({ behavior: 'smooth' });
            }
        }
    });

    // Vote function
    async function voteRecipe(recipeId, voteType) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Recipe/Vote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${recipeId}&voteType=${voteType}`
            });

            const result = await response.json();

            if (result.success) {
                // Update UI
                updateVoteUI(result.likes, result.dislikes, result.userVote);
                showToast(result.message, 'success');
            } else {
                showToast(result.message, 'error');
            }
        } catch (error) {
            console.error('Error voting recipe:', error);
            showToast('An error occurred while voting.', 'error');
        }
    }

    function updateVoteUI(likes, dislikes, userVote) {
        const likeBtn = document.getElementById('like-btn');
        const dislikeBtn = document.getElementById('dislike-btn');
        const likeCount = document.getElementById('like-count');
        const dislikeCount = document.getElementById('dislike-count');

        // Update counts
        if (likeCount) likeCount.textContent = likes;
        if (dislikeCount) dislikeCount.textContent = dislikes;

        // Update button styles
        if (likeBtn) {
            if (userVote === 'like') {
                likeBtn.classList.remove('btn-outline-success');
                likeBtn.classList.add('btn-success');
            } else {
                likeBtn.classList.remove('btn-success');
                likeBtn.classList.add('btn-outline-success');
            }
        }

        if (dislikeBtn) {
            if (userVote === 'dislike') {
                dislikeBtn.classList.remove('btn-outline-danger');
                dislikeBtn.classList.add('btn-danger');
            } else {
                dislikeBtn.classList.remove('btn-danger');
                dislikeBtn.classList.add('btn-outline-danger');
            }
        }
    }

    // Toast notification function
    function showToast(message, type = 'info') {
        // Create toast element
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} border-0`;
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');

        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;

        // Add to page
        const toastContainer = document.getElementById('toast-container') || createToastContainer();
        toastContainer.appendChild(toast);

        // Initialize and show toast
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();

        // Remove from DOM after hide
        toast.addEventListener('hidden.bs.toast', () => {
            toast.remove();
        });
    }

    function createToastContainer() {
        const container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'toast-container position-fixed top-0 end-0 p-3';
        container.style.zIndex = '9999';
        document.body.appendChild(container);
        return container;
    }

    // Image modal function
    function openImageModal(src, index) {
        console.log('Opening image modal for:', src);
        window.open(src, '_blank');
    }

    // Edit comment functionality
    function enableEdit(commentId, currentText) {
        // Hide the comment text
        document.getElementById(`comment-text-${commentId}`).style.display = 'none';

        // Show the edit form
        const editForm = document.getElementById(`edit-form-${commentId}`);
        editForm.style.display = 'block';

        // Set the current text in the textarea
        const textarea = document.getElementById(`edit-textarea-${commentId}`);
        textarea.value = currentText;

        // Update character count
        const charCount = editForm.querySelector('.edit-char-count');
        charCount.textContent = currentText.length;

        // Add input event listener for character count
        textarea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });
    }

    function cancelEdit(commentId) {
        // Show the comment text
        document.getElementById(`comment-text-${commentId}`).style.display = 'block';

        // Hide the edit form
        document.getElementById(`edit-form-${commentId}`).style.display = 'none';
    }
</script>

<style>
    .vote-btn {
        transition: all 0.3s ease;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 600;
    }

        .vote-btn:hover {
            transform: translateY(-2px);
        }

        .vote-btn:active {
            transform: translateY(0);
        }

    .btn-group .btn {
        border-radius: 0;
    }

        .btn-group .btn:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .btn-group .btn:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

    .vote-section .text-muted {
        font-size: 0.8rem;
    }

    .ingredient-checked {
        text-decoration: line-through;
        opacity: 0.6;
        background: rgba(42, 157, 143, 0.1) !important;
    }

        .ingredient-checked i.fa-circle {
            color: var(--text-light) !important;
        }

    /* Modal custom styles */
    #deleteModal .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    #deleteModal .btn-danger {
        background: linear-gradient(135deg, #dc3545, #c82333);
        border: none;
        padding: 8px 20px;
    }

        #deleteModal .btn-danger:hover {
            background: linear-gradient(135deg, #c82333, #bd2130);
            transform: translateY(-1px);
        }

    /* Comments Styling */
