<!-- Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="loginModalLabel">Sign In to TasteShare</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="password" class="form-label mb-0">Password</label>
                            <a href="#" id="forgotPasswordLink" class="text-success small fw-bold text-decoration-none">
                                <i class="fas fa-key me-1"></i>Forgot Password?
                            </a>
                        </div>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
                        <label class="form-check-label" for="rememberMe">
                            Remember me
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </button>
                    </div>
                </form>

                <!-- Forgot Password Form (Hidden by default) -->
                <div id="forgotPasswordForm" class="d-none">
                    <h6 class="mb-3 text-center">
                        <i class="fas fa-key text-success me-2"></i>Reset Your Password
                    </h6>
                    <form id="forgotPasswordSubmitForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="resetEmail" class="form-label">Enter your email address</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input type="email" class="form-control" id="resetEmail" name="email"
                                       placeholder="Enter your registered email" required>
                            </div>
                            <div class="form-text">We'll send you a password reset link</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-paper-plane me-2"></i>Send Reset Link
                            </button>
                            <button type="button" id="backToLogin" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Login
                            </button>
                        </div>
                    </form>

                    <div class="mt-3 text-center">
                        <div id="resetMessage" class="alert d-none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <p class="mb-0">
                    Don't have an account?
                    <a href="#" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#registerModal" class="text-success fw-bold text-decoration-none">
                        Create one
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loginModal = document.getElementById('loginModal');
        const loginForm = document.getElementById('loginForm');
        const forgotPasswordLink = document.getElementById('forgotPasswordLink');
        const forgotPasswordForm = document.getElementById('forgotPasswordForm');
        const backToLogin = document.getElementById('backToLogin');
        const forgotPasswordSubmitForm = document.getElementById('forgotPasswordSubmitForm');
        const resetMessage = document.getElementById('resetMessage');

        // Toggle between login and forgot password forms
        if (forgotPasswordLink) {
            forgotPasswordLink.addEventListener('click', function(e) {
                e.preventDefault();
                loginForm.classList.add('d-none');
                forgotPasswordForm.classList.remove('d-none');
                resetMessage.classList.add('d-none');
            });
        }

        if (backToLogin) {
            backToLogin.addEventListener('click', function() {
                forgotPasswordForm.classList.add('d-none');
                loginForm.classList.remove('d-none');
                resetMessage.classList.add('d-none');
            });
        }

        // Handle forgot password form submission
        if (forgotPasswordSubmitForm) {
    forgotPasswordSubmitForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        const email = document.getElementById('resetEmail').value;

        // Show loading state
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
        submitBtn.disabled = true;
        
        // Clear any previous messages
        resetMessage.textContent = '';
        resetMessage.classList.remove('d-block', 'alert-success', 'alert-danger');

        try {
            // Send AJAX request to forgot password endpoint
            const formData = new FormData();
            formData.append('email', email);
            
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

           const response = await fetch('/Account/ForgotPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    email: email
                })
            });

            let message = '';
            let type = 'success';

            if (response.ok) {
                // Try to parse as JSON first
                try {
                    const result = await response.json();
                    if (result.success) {
                        message = result.message || 'Password reset email sent successfully!';
                    } else {
                        message = result.message || 'An error occurred. Please try again.';
                        type = 'danger';
                    }
                } catch {
                    // If not JSON, try to get text
                    const text = await response.text();
                    message = text.includes('SuccessMessage') 
                        ? 'If an account exists with that email, you will receive password reset instructions shortly.'
                        : 'An error occurred. Please try again.';
                }
                
                if (type === 'success') {
                    // Clear form
                    document.getElementById('resetEmail').value = '';

                    // Auto-close after 3 seconds
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(loginModal);
                        if (modal) modal.hide();
                        forgotPasswordForm.classList.add('d-none');
                        loginForm.classList.remove('d-none');
                    }, 3000);
                }
            } else {
                message = 'An error occurred. Please try again.';
                type = 'danger';
            }

            // Show message
            resetMessage.textContent = message;
            resetMessage.className = `alert alert-${type} d-block`;

        } catch (error) {
            console.error('Error:', error);
            resetMessage.textContent = 'Network error. Please check your connection and try again.';
            resetMessage.className = 'alert alert-danger d-block';
        } finally {
            // Reset button state
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    });
}

        // Enhanced modal functionality
        if (loginModal) {
            loginModal.addEventListener('show.bs.modal', function() {
                document.body.style.overflow = 'hidden';
                // Reset forms when modal opens
                loginForm.classList.remove('d-none');
                forgotPasswordForm.classList.add('d-none');
                resetMessage.classList.add('d-none');
            });

            loginModal.addEventListener('hidden.bs.modal', function() {
                document.body.style.overflow = 'auto';
                // Reset to login form when modal closes
                setTimeout(() => {
                    loginForm.classList.remove('d-none');
                    forgotPasswordForm.classList.add('d-none');
                    resetMessage.classList.add('d-none');
                }, 300);
            });
        }

        // Login form submission loading state
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Signing In...';
                submitBtn.disabled = true;
                this.classList.add('form-loading');
            });
        }
    });

    // Global function to open login modal with forgot password
    function openLoginWithForgotPassword() {
        const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
        loginModal.show();

        // Trigger forgot password form after a short delay
        setTimeout(() => {
            const forgotPasswordLink = document.getElementById('forgotPasswordLink');
            if (forgotPasswordLink) {
                forgotPasswordLink.click();
            }
        }, 500);
    }
</script>

<style>
    /* Enhanced modal styling */
    .modal-content {
        border-radius: 15px;
        border: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border-radius: 15px 15px 0 0;
        border-bottom: none;
        padding: 1.5rem;
    }

    .modal-title {
        font-weight: 600;
    }

    .btn-close {
        filter: invert(1) brightness(100%);
        opacity: 0.8;
    }

        .btn-close:hover {
            opacity: 1;
        }

    .modal-body {
        padding: 2rem;
    }

    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 10px;
        border: 2px solid #e9ecef;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #28a745;
            box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.25);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #e9ecef;
        border-radius: 10px 0 0 10px;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }

    .btn-outline-secondary {
        border-radius: 10px;
        font-weight: 500;
    }

        .btn-outline-secondary:hover {
            background-color: #f8f9fa;
        }

    /* Forgot password link styling */
    #forgotPasswordLink:hover {
        text-decoration: underline !important;
        color: #218838 !important;
    }

    /* Form transitions */
    #loginForm, #forgotPasswordForm {
        transition: opacity 0.3s ease;
    }

    /* Loading animation */
    @@keyframes pulse {
        0%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }

    100% {
        opacity: 1;
    }

    }

    .form-loading {
        animation: pulse 1.5s infinite;
    }

    /* Modal footer */
    .modal-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 15px 15px;
        padding: 1rem 2rem;
    }

        .modal-footer a:hover {
            text-decoration: underline !important;
        }

    /* Alert styling */
    .alert {
        border-radius: 10px;
        border: none;
        padding: 1rem;
        margin: 0;
    }
</style>