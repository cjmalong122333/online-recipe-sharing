@model OnlineRecipeSharing.Models.ViewModels.IngredientManagementViewModel

@{
    var ingredients = Model.Ingredients;
    var categories = Model.Categories;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* Modern Styles */
    body {
        background: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container-fluid {
        max-width: 1400px;
    }

    h1 {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid #27ae60;
        display: inline-block;
    }

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        overflow: hidden;
        margin-bottom: 25px;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .card-header {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        padding: 20px 30px;
        border-bottom: none;
    }

        .card-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
        }

    .card-body {
        padding: 30px;
    }

    /* Form Styles */
    .form-control, .form-select {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 12px 15px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #27ae60;
            box-shadow: 0 0 0 0.2rem rgba(39, 174, 96, 0.25);
        }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db, #2980b9);
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
            background: linear-gradient(135deg, #2980b9, #1f639b);
        }

    .btn-success {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
    }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(39, 174, 96, 0.4);
            background: linear-gradient(135deg, #229954, #1e8449);
        }

    /* Table Styles */
    .table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .table thead th {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-bottom: 2px solid #dee2e6;
            padding: 20px 15px;
            font-weight: 700;
            color: #2c3e50;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table tbody tr {
            transition: all 0.3s ease;
            border-radius: 10px;
        }

            .table tbody tr:hover {
                background-color: #f8f9fa;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            }

        .table tbody td {
            padding: 18px 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f3f4;
            font-weight: 500;
        }

    /* Scrollable Table Containers */
    .table-container {
        max-height: 500px;
        overflow-y: auto;
        border-radius: 0 0 20px 20px;
    }

    .categories-table-container {
        max-height: 500px;
        overflow-y: auto;
        border-radius: 0 0 20px 20px;
    }

        .table-container::-webkit-scrollbar,
        .categories-table-container::-webkit-scrollbar {
            width: 8px;
        }

        .table-container::-webkit-scrollbar-track,
        .categories-table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .table-container::-webkit-scrollbar-thumb,
        .categories-table-container::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            border-radius: 4px;
        }

            .table-container::-webkit-scrollbar-thumb:hover,
            .categories-table-container::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(135deg, #229954, #27ae60);
            }

    /* Category Badges */
    .category-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: linear-gradient(135deg, #9b59b6, #8e44ad);
        color: white;
    }

    /* Delete Button */
    .btn-delete {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        border-radius: 25px;
        padding: 8px 20px;
        color: white;
        font-weight: 600;
        font-size: 0.8rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
            background: linear-gradient(135deg, #c0392b, #a93226);
            color: white;
        }

    /* Stats Cards */
    .stats-card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        text-align: center;
        margin-bottom: 20px;
        border-left: 5px solid #27ae60;
    }

    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #27ae60;
        margin-bottom: 5px;
    }

    .stats-label {
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    /* Search and Filter */
    .search-section {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

    .search-box {
        position: relative;
    }

        .search-box input {
            padding-left: 45px;
            border-radius: 25px;
            border: 2px solid #e9ecef;
            height: 50px;
            font-size: 1rem;
        }

        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            z-index: 10;
        }

    .filter-select {
        border-radius: 25px;
        border: 2px solid #e9ecef;
        height: 50px;
        padding: 0 20px;
    }

    /* Ingredient Icon */
    .ingredient-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #f39c12, #e67e22);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        margin-right: 15px;
    }

    /* Alert Styles */
    .alert {
        border: none;
        border-radius: 12px;
        padding: 15px 20px;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
        border-left: 4px solid #28a745;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
        border-left: 4px solid #dc3545;
    }

    /* Category Management */
    .category-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 15px;
        margin-bottom: 8px;
        background: #f8f9fa;
        border-radius: 10px;
        transition: all 0.3s ease;
        border-left: 4px solid #3498db;
    }

        .category-item:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }

    .category-count {
        background: #3498db;
        color: white;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .category-actions {
        display: flex;
        gap: 5px;
        margin-left: 10px;
    }

    .btn-category-delete {
        background: #e74c3c;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.7rem;
        transition: all 0.3s ease;
    }

        .btn-category-delete:hover {
            background: #c0392b;
            transform: scale(1.1);
        }

    /* View All Button */
    .btn-view-all {
        background: transparent;
        border: 2px solid #3498db;
        color: #3498db;
        border-radius: 25px;
        padding: 8px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-view-all:hover {
            background: #3498db;
            color: white;
            transform: translateY(-2px);
        }

    /* Category Select Styles */
    .category-select-container {
        position: relative;
    }

    .btn-refresh-categories {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #6c757d;
        transition: all 0.3s ease;
    }

        .btn-refresh-categories:hover {
            color: #3498db;
            transform: translateY(-50%) rotate(180deg);
        }

    /* Modal Styles */
    .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .modal-header {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        border-bottom: none;
        border-radius: 20px 20px 0 0;
        padding: 25px 30px;
    }

        .modal-header .modal-title {
            font-weight: 600;
            font-size: 1.4rem;
        }

    .modal-body {
        padding: 30px;
    }

    .modal-footer {
        border-top: none;
        padding: 25px 30px;
        border-radius: 0 0 20px 20px;
    }

    /* Quick Actions */
    .quick-actions {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
    }

    .btn-quick-action {
        flex: 1;
        padding: 15px 20px;
        border-radius: 15px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

    .btn-quick-ingredient {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
    }

        .btn-quick-ingredient:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(52, 152, 219, 0.4);
            background: linear-gradient(135deg, #2980b9, #1f639b);
        }

    .btn-quick-category {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
        box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
    }

        .btn-quick-category:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(39, 174, 96, 0.4);
            background: linear-gradient(135deg, #229954, #1e8449);
        }

    /* Table Headers */
    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .table-title {
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

    .table-count {
        color: #6c757d;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid py-4">
    <h1><i class="fas fa-carrot me-3"></i>Manage Ingredients</h1>

    <!-- Stats Overview -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number">@ingredients.Count</div>
                <div class="stats-label">Total Ingredients</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number">@categories.Count</div>
                <div class="stats-label">Categories</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number">@ingredients.Count(i => i.IsActive)</div>
                <div class="stats-label">Active Ingredients</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number">@(ingredients.Count - ingredients.Count(i => i.IsActive))</div>
                <div class="stats-label">Inactive Ingredients</div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <button type="button" class="btn btn-quick-action btn-quick-ingredient" data-bs-toggle="modal" data-bs-target="#addIngredientModal">
            <i class="fas fa-plus-circle me-2"></i>Add New Ingredient
        </button>
        <button type="button" class="btn btn-quick-action btn-quick-category" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            <i class="fas fa-folder-plus me-2"></i>Add New Category
        </button>
    </div>

    <!-- Search and Filter Section -->
    <div class="search-section">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search ingredients by name or category..." id="searchInput">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select filter-select" id="categoryFilter">
                    <option value="">All Categories</option>
                    @foreach (var category in categories.OrderBy(c => c.CategoryName))
                    {
                        <option value="@category.CategoryName">@category.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select filter-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Display messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column - Categories List -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-tags me-2"></i>All Categories</h5>
                </div>
                <div class="card-body p-0">
                    <div class="categories-table-container">
                        <div class="p-3 border-bottom">
                            <div class="table-header">
                                <h6 class="table-title">Category List</h6>
                                <span class="table-count">@categories.Count categories</span>
                            </div>
                        </div>
                        <div class="p-3">
                            @foreach (var category in categories.OrderBy(c => c.CategoryName))
                            {
                                var categoryCount = ingredients.Count(i => i.Category == category.CategoryName && i.IsActive);
                                <div class="category-item">
                                    <div>
                                        <span class="fw-bold">@category.CategoryName</span>
                                        <br>
                                        <small class="text-muted">@categoryCount ingredient@(categoryCount != 1 ? "s" : "")</small>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <span class="category-count">@categoryCount</span>
                                        @if (categoryCount == 0)
                                        {
                                            <div class="category-actions">
                                                <form method="post" asp-action="DeleteCategory" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@category._id">
                                                    <button type="submit" class="btn-category-delete"
                                                            onclick="return confirm('Are you sure you want to delete the category \" @category.CategoryName\"?')"
                                                            title="Delete category">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!categories.Any())
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-folder-open fa-3x mb-3"></i>
                                    <h5 class="text-muted">No Categories Found</h5>
                                    <p class="text-muted">Add your first category using the button above.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Ingredients List -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>All Ingredients</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-container">
                        <div class="p-3 border-bottom">
                            <div class="table-header">
                                <h6 class="table-title">Ingredient List</h6>
                                <span class="table-count">@ingredients.Count(i => i.IsActive) active ingredients</span>
                            </div>
                        </div>
                        <table class="table table-hover mb-0" id="ingredientsTable">
                            <thead>
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ingredient in ingredients.Where(i => i.IsActive))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="ingredient-icon">
                                                    <i class="fas fa-carrot"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@ingredient.Name</div>
                                                    <div class="text-muted small">Added: @ingredient.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="category-badge">@ingredient.Category</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                        <td>
                                            <form method="post" asp-action="DeleteIngredient" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@ingredient._id">
                                                <button type="submit" class="btn btn-delete btn-sm"
                                                        onclick="return confirm('Are you sure you want to delete \" @ingredient.Name\"? This action cannot be undone.')">
                                                    <i class="fas fa-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Empty State -->
                        @if (!ingredients.Any(i => i.IsActive))
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-carrot fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No Ingredients Found</h4>
                                <p class="text-muted">Start by adding your first ingredient using the button above.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Ingredient Modal -->
<div class="modal fade" id="addIngredientModal" tabindex="-1" aria-labelledby="addIngredientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addIngredientModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Add New Ingredient
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="AddIngredient" id="ingredientForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="form-label">Ingredient Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g., Bell Pepper" required>
                        <div class="form-text">Enter the name of the ingredient</div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="form-label">Category</label>
                        <div class="category-select-container">
                            <select name="category" class="form-select" id="categorySelect" required>
                                <option value="">Select a category</option>
                                @foreach (var category in categories.OrderBy(c => c.CategoryName))
                                {
                                    <option value="@category.CategoryName">@category.CategoryName</option>
                                }
                            </select>
                            <button type="button" class="btn-refresh-categories" onclick="refreshCategories()" title="Refresh categories">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                        <div class="form-text">Choose from existing categories</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Ingredient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCategoryModalLabel">
                    <i class="fas fa-folder-plus me-2"></i>Add New Category
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="AddCategory" id="categoryForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="form-label">Category Name</label>
                        <input type="text" name="categoryName" class="form-control" placeholder="e.g., Dairy Products" required>
                        <div class="form-text">Create a new category for ingredients</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-folder me-2"></i>Add Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Search and Filter -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const statusFilter = document.getElementById('statusFilter');
        const table = document.getElementById('ingredientsTable');
        const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        function filterIngredients() {
            const searchTerm = searchInput.value.toLowerCase();
            const categoryValue = categoryFilter.value.toLowerCase();
            const statusValue = statusFilter.value;

            for (let row of rows) {
                const ingredientName = row.cells[0].textContent.toLowerCase();
                const category = row.cells[1].textContent.toLowerCase();
                const status = row.cells[2].textContent.toLowerCase();

                const matchesSearch = ingredientName.includes(searchTerm);
                const matchesCategory = !categoryValue || category === categoryValue;
                const matchesStatus = !statusValue ||
                    (statusValue === 'active' && status.includes('active')) ||
                    (statusValue === 'inactive' && status.includes('inactive'));

                row.style.display = matchesSearch && matchesCategory && matchesStatus ? '' : 'none';
            }
        }

        searchInput.addEventListener('input', filterIngredients);
        categoryFilter.addEventListener('change', filterIngredients);
        statusFilter.addEventListener('change', filterIngredients);

        // Form submission enhancement
        const ingredientForm = document.getElementById('ingredientForm');
        ingredientForm.addEventListener('submit', function() {
            const button = ingredientForm.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Adding...';
            button.disabled = true;

            // Close modal after submission
            setTimeout(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addIngredientModal'));
                modal.hide();
            }, 1000);
        });

        const categoryForm = document.getElementById('categoryForm');
        categoryForm.addEventListener('submit', function() {
            const button = categoryForm.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Adding...';
            button.disabled = true;

            // Close modal after submission
            setTimeout(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'));
                modal.hide();
            }, 1000);
        });

        // Reset forms when modal is hidden
        document.getElementById('addIngredientModal').addEventListener('hidden.bs.modal', function () {
            ingredientForm.reset();
            const button = ingredientForm.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-plus me-2"></i>Add Ingredient';
            button.disabled = false;
        });

        document.getElementById('addCategoryModal').addEventListener('hidden.bs.modal', function () {
            categoryForm.reset();
            const button = categoryForm.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-folder me-2"></i>Add Category';
            button.disabled = false;
        });
    });

    async function refreshCategories() {
        const button = event.target.closest('button');
        const icon = button.querySelector('i');

        // Add spinning animation
        icon.className = 'fas fa-spinner fa-spin';

        try {
            const response = await fetch('/Admin/GetCategories');
            const categories = await response.json();

            // Update category dropdowns
            updateCategoryDropdowns(categories);

            // Show success feedback
            icon.className = 'fas fa-check';
            setTimeout(() => {
                icon.className = 'fas fa-sync-alt';
            }, 2000);

        } catch (error) {
            console.error('Error refreshing categories:', error);
            icon.className = 'fas fa-exclamation-triangle';
            setTimeout(() => {
                icon.className = 'fas fa-sync-alt';
            }, 2000);
        }
    }

    function updateCategoryDropdowns(categories) {
        // Update ingredient form dropdown
        const categorySelect = document.getElementById('categorySelect');
        const categoryFilter = document.getElementById('categoryFilter');

        // Clear existing options (keep first option)
        categorySelect.innerHTML = '<option value="">Select a category</option>';
        categoryFilter.innerHTML = '<option value="">All Categories</option>';

        // Add new categories
        categories.forEach(category => {
            const option1 = new Option(category.categoryName, category.categoryName);
            const option2 = new Option(category.categoryName, category.categoryName);
            categorySelect.add(option1);
            categoryFilter.add(option2);
        });
    }
</script>