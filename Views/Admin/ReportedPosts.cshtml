</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        // Your existing JavaScript code remains the same
        let currentReportId = '';
        let currentRecipeId = '';

        // Filter and Search functionality
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing report management...');

            const searchInput = document.getElementById('searchInput');
            const reasonFilter = document.getElementById('reasonFilter');
            const sortFilter = document.getElementById('sortFilter');
            const resetFilters = document.getElementById('resetFilters');
            const reportItems = document.querySelectorAll('.report-item');

            function filterReports() {
                const searchTerm = searchInput.value.toLowerCase();
                const reasonValue = reasonFilter.value;
                const sortValue = sortFilter.value;

                let visibleItems = [];

                reportItems.forEach(item => {
                    const reason = item.getAttribute('data-reason') || '';
                    const date = item.getAttribute('data-date') || '';
                    const textContent = item.textContent.toLowerCase();

                    const matchesSearch = !searchTerm || textContent.includes(searchTerm);
                    const matchesReason = !reasonValue || reason === reasonValue;

                    if (matchesSearch && matchesReason) {
                        item.style.display = '';
                        visibleItems.push(item);
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Sort items
                if (sortValue === 'oldest') {
                    visibleItems.sort((a, b) => new Date(a.getAttribute('data-date')) - new Date(b.getAttribute('data-date')));
                } else {
                    visibleItems.sort((a, b) => new Date(b.getAttribute('data-date')) - new Date(a.getAttribute('data-date')));
                }

                // Reorder DOM
                const grid = document.getElementById('reportsGrid');
                if (grid) {
                    visibleItems.forEach(item => grid.appendChild(item));
                }
            }

            if (searchInput) searchInput.addEventListener('input', filterReports);
            if (reasonFilter) reasonFilter.addEventListener('change', filterReports);
            if (sortFilter) sortFilter.addEventListener('change', filterReports);

            if (resetFilters) {
                resetFilters.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (reasonFilter) reasonFilter.value = '';
                    if (sortFilter) sortFilter.value = 'newest';
                    filterReports();
                });
            }

            // Attach click handlers to report cards (open details)
            document.querySelectorAll('.report-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    // Don't trigger if clicking on action buttons
                    if (e.target.closest('.action-btn') || e.target.closest('.btn-group') || e.target.closest('button')) {
                        return;
                    }

                    const recipeId = this.getAttribute('data-recipe-id');
                    const reportId = this.getAttribute('data-report-id');

                    if (recipeId && reportId) {
                        showRecipeDetails(recipeId, reportId);
                    }
                });
            });

            // Bind modal buttons for preview modal
            const previewRemoveBtn = document.getElementById('previewModalRemoveBtn');
            const previewKeepBtn = document.getElementById('previewModalKeepBtn');

            if (previewRemoveBtn) {
                previewRemoveBtn.addEventListener('click', function() {
                    if (!currentReportId) {
                        showToast('Error', 'No report selected', 'error');
                        return;
                    }
                    if (confirm('Are you sure you want to remove this recipe? This action cannot be undone.')) {
                        updateReportStatus(currentReportId, 'dismissed');
                        const instance = bootstrap.Modal.getInstance(document.getElementById('recipePreviewModal'));
                        if (instance) instance.hide();
                    }
                });
            }

            if (previewKeepBtn) {
                previewKeepBtn.addEventListener('click', function() {
                    if (!currentReportId) {
                        showToast('Error', 'No report selected', 'error');
                        return;
                    }
                    if (confirm('Mark this report as resolved and keep the recipe?')) {
                        updateReportStatus(currentReportId, 'resolved');
                        const instance = bootstrap.Modal.getInstance(document.getElementById('recipePreviewModal'));
                        if (instance) instance.hide();
                    }
                });
            }

            // Bind modal buttons for details modal
            const detailsRemoveBtn = document.getElementById('detailsModalRemoveBtn');
            const detailsKeepBtn = document.getElementById('detailsModalKeepBtn');

            if (detailsRemoveBtn) {
                detailsRemoveBtn.addEventListener('click', function() {
                    if (!currentReportId) {
                        showToast('Error', 'No report selected', 'error');
                        return;
                    }
                    if (confirm('Are you sure you want to remove this recipe? This action cannot be undone.')) {
                        updateReportStatus(currentReportId, 'dismissed');
                        const instance = bootstrap.Modal.getInstance(document.getElementById('recipeDetailsModal'));
                        if (instance) instance.hide();
                    }
                });
            }

            if (detailsKeepBtn) {
                detailsKeepBtn.addEventListener('click', function() {
                    if (!currentReportId) {
                        showToast('Error', 'No report selected', 'error');
                        return;
                    }
                    if (confirm('Mark this report as resolved and keep the recipe?')) {
                        updateReportStatus(currentReportId, 'resolved');
                        const instance = bootstrap.Modal.getInstance(document.getElementById('recipeDetailsModal'));
                        if (instance) instance.hide();
                    }
                });
            }

            // Load stats
            loadReportStats();
        });

        // Show recipe preview modal
        async function showRecipePreview(recipeId, reportId) {
            currentReportId = reportId;
            currentRecipeId = recipeId;

            try {
                // Show loading state
                document.getElementById('recipePreviewBody').innerHTML = `
                    <div class="text-center py-4">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading recipe details...</p>
                    </div>
                `;

                const modalEl = document.getElementById('recipePreviewModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();

                // Fetch recipe details
                const response = await fetch(`/Recipe/GetRecipeDetails/${recipeId}`);
                if (!response.ok) {
                    throw new Error('Failed to fetch recipe details');
                }

                const recipe = await response.json();

                // Populate modal with recipe data (API expected to return flat json)
                document.getElementById('recipePreviewBody').innerHTML = `
                    <div class="recipe-preview-content">
                        ${recipe.image_url ? `<img src="${recipe.image_url}" class="recipe-image" alt="${recipe.title}">` : ''}

                        <div class="recipe-details">
                            <h4 class="text-success mb-3">${recipe.title}</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong><i class="fa-solid fa-clock me-2"></i>Prep Time:</strong> ${recipe.prep_time || 'N/A'} minutes</p>
                                    <p><strong><i class="fa-solid fa-fire me-2"></i>Cook Time:</strong> ${recipe.cook_time || 'N/A'} minutes</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong><i class="fa-solid fa-utensils me-2"></i>Servings:</strong> ${recipe.servings || 'N/A'}</p>
                                    <p><strong><i class="fa-solid fa-chart-line me-2"></i>Difficulty:</strong> ${recipe.difficulty || 'N/A'}</p>
                                </div>
                            </div>
                        </div>

                        ${recipe.ingredients && recipe.ingredients.length > 0 ? `
                            <div class="ingredients-list">
                                <h5 class="text-success mb-3"><i class="fa-solid fa-list me-2"></i>Ingredients</h5>
                                <ul class="list-unstyled">
                                    ${recipe.ingredients.map(ingredient => `<li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>${ingredient}</li>`).join('')}
                                </ul>
                            </div>
                        ` : ''}

                        ${recipe.instructions && recipe.instructions.length > 0 ? `
                            <div class="instructions-list">
                                <h5 class="text-success mb-3"><i class="fa-solid fa-book me-2"></i>Instructions</h5>
                                <ol>
                                    ${recipe.instructions.map(instruction => `<li class="mb-3">${instruction}</li>`).join('')}
                                </ol>
                            </div>
                        ` : ''}

                        ${recipe.description ? `
                            <div class="description-box">
                                <h6 class="text-success mb-2"><i class="fa-solid fa-file-lines me-2"></i>Description</h6>
                                <p class="mb-0">${recipe.description}</p>
                            </div>
                        ` : ''}
                    </div>
                `;

            } catch (error) {
                console.error('Error loading recipe preview:', error);
                document.getElementById('recipePreviewBody').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-exclamation-triangle me-2"></i>
                        Error loading recipe details. Please try again.
                    </div>
                `;
            }
        }

        function resolveReport(reportId, action) {
            console.log('Resolving report:', reportId, 'Action:', action);

            if (!reportId) {
                alert('Invalid report ID');
                return;
            }

            const modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');
            const confirmBtn = document.getElementById('confirmAction');

            // Remove previous click handlers to avoid multiple bindings
            confirmBtn.replaceWith(confirmBtn.cloneNode(true));
            const newConfirm = document.getElementById('confirmAction');

            if (action === 'remove') {
                modalTitle.innerHTML = '<i class="fa-solid fa-trash text-danger me-2"></i>Remove Recipe';
                modalBody.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone.
                    </div>
                    <p>Are you sure you want to remove this recipe? The recipe will be permanently hidden from the platform.</p>
                `;
                newConfirm.className = 'btn btn-danger';
                newConfirm.innerHTML = '<i class="fa-solid fa-trash me-2"></i>Remove Recipe';

                newConfirm.addEventListener('click', function handler() {
                    updateReportStatus(reportId, 'dismissed');
                    modal.hide();
                    newConfirm.removeEventListener('click', handler);
                });
            } else {
                modalTitle.innerHTML = '<i class="fa-solid fa-check text-success me-2"></i>Keep Recipe';
                modalBody.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fa-solid fa-info-circle me-2"></i>
                        Mark this report as resolved and keep the recipe visible.
                    </div>
                    <p>Are you sure you want to keep this recipe? The report will be marked as resolved.</p>
                `;
                newConfirm.className = 'btn btn-success';
                newConfirm.innerHTML = '<i class="fa-solid fa-check me-2"></i>Keep Recipe';

                newConfirm.addEventListener('click', function handler() {
                    updateReportStatus(reportId, 'resolved');
                    modal.hide();
                    newConfirm.removeEventListener('click', handler);
                });
            }

            modal.show();
        }

        function updateReportStatus(reportId, status) {
            console.log('Updating report status:', reportId, status);

            if (!reportId || !status) {
                alert('Missing required parameters');
                return;
            }

            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert('Security token missing. Please refresh the page.');
                return;
            }

            const formData = new URLSearchParams();
            formData.append('reportId', reportId);
            formData.append('status', status);

            fetch('@Url.Action("UpdateStatus", "Admin")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token.value,
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    console.log('Success:', data.message);
                    // Show success message and reload
                    showToast('Success', data.message, 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    console.error('Error:', data.message);
                    showToast('Error', data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Fetch error:', error);
                showToast('Error', 'Error updating report status. Please try again.', 'error');
            });
        }

        // Also update the "Mark as Reviewed" button to use the same function
        function updateStatus(reportId, status) {
            updateReportStatus(reportId, status);
        }

        // Show recipe details modal
        async function showRecipeDetails(recipeId, reportId) {
            currentReportId = reportId;
            currentRecipeId = recipeId;

            const modalEl = document.getElementById('recipeDetailsModal');
            const modal = new bootstrap.Modal(modalEl);
            const loadingSpinner = document.getElementById('loadingSpinner');
            const recipeContent = document.getElementById('recipeContent');
            const recipeError = document.getElementById('recipeError');

            // Reset states
            loadingSpinner.style.display = 'block';
            recipeContent.style.display = 'none';
            recipeError.style.display = 'none';

            // Show modal
            modal.show();

            try {
                // Fetch recipe details from your API
                const response = await fetch(`/Admin/GetRecipeDetails?id=${encodeURIComponent(recipeId)}`);
                if (!response.ok) {
                    throw new Error('Failed to fetch recipe details');
                }

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.message || 'Failed to load recipe');
                }

                const recipe = result.data;

                // Populate modal with recipe data
                populateRecipeModal(recipe);

                // Show content
                loadingSpinner.style.display = 'none';
                recipeContent.style.display = 'block';

            } catch (error) {
                console.error('Error loading recipe:', error);
                loadingSpinner.style.display = 'none';
                recipeError.style.display = 'block';
                document.getElementById('errorMessage').textContent = error.message || 'Error loading recipe details';
            }
        }

        // Populate the modal with recipe data
        function populateRecipeModal(recipe) {
            // Set recipe image
            const recipeImage = document.getElementById('recipeImage');
            if (recipe.images && recipe.images.length > 0) {
                recipeImage.src = recipe.images[0];
                recipeImage.style.display = 'block';
            } else {
                recipeImage.style.display = 'none';
            }

            // Set recipe title
            document.getElementById('recipeTitle').textContent = recipe.title || 'Untitled Recipe';

            // Set recipe description
            const descriptionElement = document.getElementById('recipeDescription');
            if (recipe.description) {
                descriptionElement.textContent = recipe.description;
                descriptionElement.style.display = 'block';
            } else {
                descriptionElement.innerHTML = '<em class="text-muted">No description provided.</em>';
            }

            // Set recipe meta information
            const metaElement = document.getElementById('recipeMeta');
            metaElement.innerHTML = `
                <div class="meta-item">
                    <i class="fa-solid fa-user me-2"></i>
                    <span>By ${recipe.author}</span>
                </div>
                <div class="meta-item">
                    <i class="fa-solid fa-calendar me-2"></i>
                    <span>${recipe.created_at}</span>
                </div>
                <div class="meta-item">
                    <i class="fa-solid fa-heart me-2"></i>
                    <span>${recipe.upvotes} upvotes</span>
                </div>
            `;

            // Populate ingredients
            const ingredientsList = document.getElementById('ingredientsList');
            ingredientsList.innerHTML = '';

            if (recipe.ingredients && recipe.ingredients.length > 0) {
                recipe.ingredients.forEach(ingredient => {
                    const ingredientElement = document.createElement('div');
                    ingredientElement.className = 'ingredient-item';
                    ingredientElement.innerHTML = `
                        <i class="fa-regular fa-circle ingredient-checkbox"></i>
                        <span>${ingredient}</span>
                    `;
                    ingredientsList.appendChild(ingredientElement);
                });
            } else {
                ingredientsList.innerHTML = '<p class="text-muted text-center">No ingredients listed.</p>';
            }

            // Populate instructions
            const instructionsList = document.getElementById('instructionsList');
            instructionsList.innerHTML = '';

            if (recipe.instructions && recipe.instructions.length > 0) {
                recipe.instructions.forEach((instruction, index) => {
                    const instructionElement = document.createElement('div');
                    instructionElement.className = 'instruction-item';
                    instructionElement.innerHTML = `
                        <div class="instruction-number">${index + 1}</div>
                        <div class="instruction-text">${instruction}</div>
                    `;
                    instructionsList.appendChild(instructionElement);
                });
            } else {
                instructionsList.innerHTML = '<p class="text-muted text-center">No instructions provided.</p>';
            }

            // Populate category and tags
            const categoryTagsElement = document.getElementById('categoryTags');
            let categoryTagsHtml = '';

            if (recipe.category) {
                categoryTagsHtml += `<div class="mb-2"><strong>Category:</strong> ${recipe.category}</div>`;
            }

            if (recipe.tags && recipe.tags.length > 0) {
                categoryTagsHtml += `<div><strong>Tags:</strong> ${recipe.tags.join(', ')}</div>`;
            }

            categoryTagsElement.innerHTML = categoryTagsHtml || '<em class="text-muted">No category or tags</em>';

            // Populate recipe stats
            const recipeStatsElement = document.getElementById('recipeStats');
            recipeStatsElement.innerHTML = `
                <div class="mb-2"><strong>Upvotes:</strong> ${recipe.upvotes}</div>
                <div class="mb-2"><strong>Comments:</strong> ${recipe.comments_count}</div>
                <div><strong>Status:</strong> <span class="badge bg-success">Active</span></div>
            `;
        }

        async function loadReportStats() {
            try {
                console.log('Loading report stats...');
                const response = await fetch('@Url.Action("GetReportStats", "Admin")');
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const result = await response.json();

                if (result.success) {
                    console.log('Stats loaded:', result.data);
                    const stats = result.data;
                    document.getElementById('totalReports').textContent = stats.totalReports || 0;
                    document.getElementById('resolvedReports').textContent = stats.resolvedReports || 0;
                    document.getElementById('dismissedReports').textContent = stats.dismissedReports || 0;
                } else {
                    console.error('Error loading stats:', result.message);
                    setFallbackStats();
                }
            } catch (error) {
                console.error('Error loading stats:', error);
                setFallbackStats();
            }
        }

        function setFallbackStats() {
            const pendingCount = @Model.Count;
            document.getElementById('totalReports').textContent = pendingCount;
            document.getElementById('resolvedReports').textContent = '0';
            document.getElementById('dismissedReports').textContent = '0';
        }

        // Utility function to show toast messages
        function showToast(title, message, type) {
            // You can implement a toast notification here
            // For now, using alert as fallback
            alert(`${title}: ${message}`);
        }
    </script>
}