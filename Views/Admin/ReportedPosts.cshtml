@model List<OnlineRecipeSharing.Models.ViewModels.ReportViewModel>
@{
    ViewData["Title"] = "Reported Posts";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* Global Styles */
    body {
        background: linear-gradient(135deg, #f0fdf4 0%, #e9ecef 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        color: #1e293b;
    }

    .container-fluid {
        max-width: 1400px;
    }

    /* Page Header - Same as User Management */
    h1 {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid #3498db;
        display: inline-block;
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Stats Cards */
    .stats-card {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        text-align: center;
        margin-bottom: 20px;
        animation: fadeInUp 0.6s ease;
    }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #3498db;
        margin-bottom: 5px;
    }

    .stats-label {
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    /* Report Cards */
    .report-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(34, 197, 94, 0.15);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        height: 100%;
        background: white;
        position: relative;
        border-left: 5px solid #22c55e;
        animation: fadeInUp 0.6s ease;
    }

        .report-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #22c55e, #4ade80);
        }

        .report-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 40px rgba(34, 197, 94, 0.25);
        }

    .report-header {
        background: linear-gradient(135deg, #1e293b 0%, #22c55e 100%);
        color: white;
        padding: 20px;
        border-bottom: none;
        position: relative;
    }

    .reason-badge {
        background: rgba(255,255,255,0.2);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
        border: 2px solid white;
    }

    /* Action Buttons */
    .action-btn {
        border: none;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-remove {
        background: linear-gradient(135deg, #ef4444 0%, #c0392b 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }

        .btn-remove:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
            background: linear-gradient(135deg, #c0392b 0%, #a93226 100%);
            color: white;
        }

    .btn-keep {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
    }

        .btn-keep:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
            background: linear-gradient(135deg, #16a34a 0%, #1e8449 100%);
            color: white;
        }

    .btn-preview {
        background: linear-gradient(135deg, #0ea5e9 0%, #2980b9 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
    }

        .btn-preview:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
            background: linear-gradient(135deg, #2980b9 0%, #2471a3 100%);
            color: white;
        }

    /* Filter Section */
    .filter-section {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        margin-bottom: 25px;
        animation: fadeInUp 0.6s ease;
    }

    .search-box {
        position: relative;
    }

        .search-box input {
            padding-left: 45px;
            border-radius: 25px;
            border: 2px solid #e9ecef;
            height: 50px;
            font-size: 1rem;
        }

        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            z-index: 10;
        }

    .filter-select {
        border-radius: 25px;
        border: 2px solid #e9ecef;
        height: 50px;
        padding: 0 20px;
    }

    /* Description Box */
    .description-box {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-left: 4px solid #22c55e;
        border-radius: 10px;
        padding: 15px;
        margin: 10px 0;
        font-style: italic;
    }

    /* Empty State */
    .empty-state {
        background: white;
        border-radius: 20px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(34, 197, 94, 0.1);
        border: 2px dashed #86efac;
        animation: fadeInUp 0.6s ease;
    }

    .empty-icon {
        font-size: 4rem;
        color: #86efac;
        margin-bottom: 20px;
    }

    /* Status Badge */
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-pending {
        background: linear-gradient(135deg, #eab308 0%, #e67e22 100%);
        color: white;
    }

    /* Report Meta */
    .report-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: #6c757d;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(34, 197, 94, 0.1);
        padding: 4px 10px;
        border-radius: 12px;
        color: #16a34a;
    }

    .action-buttons {
        display: grid;
        gap: 10px;
        margin-top: 15px;
    }

    /* Back Button */
    .back-btn {
        background: linear-gradient(135deg, #27ae60, #229954);
        border: none;
        border-radius: 25px;
        padding: 10px 25px;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .back-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(39, 174, 96, 0.4);
            background: linear-gradient(135deg, #229954, #1e8449);
            color: white;
            text-decoration: none;
        }

    /* Alerts */
    .alert {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
        border-left: 4px solid #22c55e;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da 0%, #f1b0b7 100%);
        color: #721c24;
        border-left: 4px solid #ef4444;
    }

    /* Recipe Details Modal */
    .recipe-details-modal .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        overflow: hidden;
        background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%);
    }

    .recipe-details-modal .modal-header {
        background: linear-gradient(135deg, #1e293b 0%, #22c55e 100%);
        color: white;
        border-bottom: none;
        padding: 20px 30px;
    }

    .recipe-details-modal .modal-body {
        max-height: 70vh;
        overflow-y: auto;
        padding: 0;
    }

    .recipe-header {
        background: linear-gradient(135deg, #1e293b 0%, #22c55e 100%);
        color: white;
        min-height: 200px;
    }

    .recipe-overlay {
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
    }

    .recipe-title {
        font-size: 2.5rem;
        font-weight: 800;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    .recipe-meta .meta-item {
        background: rgba(255,255,255,0.2);
        padding: 8px 16px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
    }

    .section-title {
        font-weight: 700;
        border-bottom: 3px solid #22c55e;
        padding-bottom: 10px;
    }

    .ingredients-list, .instructions-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .ingredient-item {
        padding: 12px 0;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

        .ingredient-item:last-child {
            border-bottom: none;
        }

    .ingredient-checkbox {
        color: #22c55e;
        margin-top: 2px;
    }

    .instruction-item {
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        gap: 15px;
    }

        .instruction-item:last-child {
            border-bottom: none;
        }

    .instruction-number {
        background: #22c55e;
        color: white;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        flex-shrink: 0;
    }

    .instruction-text {
        flex: 1;
        line-height: 1.6;
    }

    .loading-spinner {
        text-align: center;
        padding: 60px 20px;
    }

    .info-card {
        border-left: 4px solid #22c55e;
    }

    /* Recipe Preview Modal */
    .recipe-preview-modal .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%);
    }

    .recipe-preview-modal .modal-header {
        background: linear-gradient(135deg, #1e293b 0%, #22c55e 100%);
        color: white;
        border-radius: 20px 20px 0 0;
        border-bottom: none;
        padding: 25px;
    }

    .recipe-preview-modal .modal-body {
        padding: 30px;
        max-height: 60vh;
        overflow-y: auto;
    }

    .recipe-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .recipe-details {
        background: rgba(134, 239, 172, 0.2);
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .ingredients-list, .instructions-list {
        background: white;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        border: 1px solid #e9ecef;
    }

    .modal-action-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-modal-remove {
        background: linear-gradient(135deg, #ef4444 0%, #c0392b 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-modal-remove:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
        }

    .btn-modal-keep {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-modal-keep:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
        }

    /* Confirmation Modal */
    .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%);
    }

    .modal-header {
        background: linear-gradient(135deg, #1e293b 0%, #22c55e 100%);
        color: white;
        border-bottom: none;
        padding: 25px 30px 20px;
        position: relative;
    }

        .modal-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: #eab308;
            border-radius: 2px;
        }

    .modal-title {
        font-weight: 700;
        font-size: 1.5rem;
        text-align: center;
        width: 100%;
        margin: 0;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
    }

    .btn-close {
        background: transparent url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/%3e%3c/svg%3e") center/1em auto no-repeat;
        opacity: 0.8;
        transition: all 0.3s ease;
        position: absolute;
        right: 20px;
        top: 20px;
    }

        .btn-close:hover {
            opacity: 1;
            transform: rotate(90deg);
        }

    .modal-backdrop {
        background-color: rgba(30, 41, 59, 0.8);
        backdrop-filter: blur(5px);
    }

        .modal-backdrop.show {
            opacity: 1;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .stats-card {
            margin-bottom: 15px;
        }

        .report-card {
            margin-bottom: 20px;
        }

        .modal-action-buttons {
            grid-template-columns: 1fr;
        }

        .recipe-meta {
            flex-direction: column;
            gap: 10px;
        }

        .action-buttons {
            grid-template-columns: 1fr;
        }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
        background: #86efac;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #22c55e;
        }
</style>

<div class="container-fluid py-4">
    <!-- Page Header - Same as User Management -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-flag me-3"></i>Reported Content Management</h1>
        <div class="d-flex gap-3 align-items-center">
            <a href="@Url.Action("Dashboard", "Admin")" class="back-btn">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <span class="status-badge badge-pending">
                <i class="fas fa-clock me-1"></i>@Model.Count Pending
            </span>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number text-warning">@Model.Count</div>
                <div class="stats-label">Pending Reports</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number text-info" id="totalReports">-</div>
                <div class="stats-label">Total Reports</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number text-success" id="resolvedReports">-</div>
                <div class="stats-label">Resolved</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number text-danger" id="dismissedReports">-</div>
                <div class="stats-label">Recipes Removed</div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="filter-section">
        <div class="row align-items-center">
            <div class="col-md-4">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search by reason, description, or reporter..." id="searchInput">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select filter-select" id="reasonFilter">
                    <option value="">All Reasons</option>
                    <option value="Inappropriate Content">Inappropriate Content</option>
                    <option value="Spam or Misleading">Spam or Misleading</option>
                    <option value="Copyright Violation">Copyright Violation</option>
                    <option value="Harassment or Hate Speech">Harassment or Hate Speech</option>
                    <option value="False Information">False Information</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select filter-select" id="sortFilter">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" id="resetFilters">
                    <i class="fas fa-rotate-left me-2"></i>Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Reports Grid -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-check-circle empty-icon"></i>
            <h3 class="text-muted mb-3">No Pending Reports</h3>
            <p class="text-muted mb-4">All reports have been reviewed and resolved. Great job!</p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-primary">
                    <i class="fas fa-dashboard me-2"></i>Go to Dashboard
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row" id="reportsGrid">
            @foreach (var reportVm in Model)
            {
                var report = reportVm.Report;
                <div class="col-lg-6 col-xl-4 mb-4 report-item"
                     data-reason="@report.Reason"
                     data-date="@report.CreatedAt.ToString("yyyy-MM-dd")">
                    <div class="report-card"
                         data-recipe-id="@report.RecipeId"
                         data-report-id="@report._id"
                         style="cursor: pointer;">
                        <div class="report-header d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar">
                                    @if (!string.IsNullOrEmpty(reportVm.ReporterUsername))
                                    {
                                        @reportVm.ReporterUsername.Substring(0, 1).ToUpper()
                                    }
                                    else
                                    {
                                        @:U
                                    }
                                </div>
                                <div>
                                    <div class="fw-bold">@reportVm.ReporterUsername</div>
                                    <div class="reason-badge">@report.Reason</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-white-50 small">@report.CreatedAt.ToString("MMM dd")</div>
                                <div class="text-white-50 small">@report.CreatedAt.ToString("hh:mm tt")</div>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Recipe Information -->
                            <div class="mb-3">
                                <div class="fw-semibold text-primary mb-2">
                                    <i class="fas fa-utensils me-2"></i>Recipe Information
                                </div>
                                <div class="fw-bold">@reportVm.RecipeTitle</div>
                                <div class="small text-muted">ID: @report.RecipeId</div>
                            </div>

                            <!-- Additional Details -->
                            @if (!string.IsNullOrEmpty(report.description))
                            {
                                <div class="mb-3">
                                    <div class="fw-semibold text-primary mb-2">
                                        <i class="fas fa-comment me-2"></i>Report Details
                                    </div>
                                    <div class="description-box">
                                        <em>"@report.description"</em>
                                    </div>
                                </div>
                            }

                            <!-- Report Metadata -->
                            <div class="report-meta">
                                <div class="meta-item">
                                    <i class="fas fa-calendar"></i>
                                    <span>@report.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="meta-item">
                                    <i class="fas fa-clock"></i>
                                    <span>@report.CreatedAt.ToString("hh:mm tt")</span>
                                </div>
                                <div class="meta-item">
                                    <i class="fas fa-user"></i>
                                    <span>@reportVm.ReporterUsername</span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <button type="button"
                                    class="btn btn-preview action-btn"
                                    onclick="showRecipePreview('@report.RecipeId', '@report._id')">
                                <i class="fas fa-eye me-1"></i>Preview Recipe
                            </button>
                            <div class="btn-group w-100" role="group">
                                <button type="button"
                                        class="btn btn-remove action-btn"
                                        onclick="resolveReport('@report._id', 'remove')">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                                <button type="button"
                                        class="btn btn-keep action-btn"
                                        onclick="resolveReport('@report._id', 'keep')">
                                    <i class="fas fa-check me-1"></i>Keep
                                </button>
                            </div>
