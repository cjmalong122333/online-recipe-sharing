            }
        </div>
    }

    <!-- Rest of your modals and scripts remain the same -->
    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
