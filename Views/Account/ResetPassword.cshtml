@model OnlineRecipeSharing.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="fas fa-key me-2"></i>Reset Your Password
                    </h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Success/Error Messages -->
                    <div id="alertContainer">
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                    </div>

                    <!-- Reset Password Form -->
                    <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden fields for email and token -->
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-4">
                            <p class="text-muted mb-1">
                                <i class="fas fa-info-circle me-2 text-success"></i>
                                Please enter your new password below.
                            </p>
                            <p class="text-muted small mb-0">
                                Your password must be at least 6 characters long. For better security, use a combination of letters, numbers, and symbols.
                            </p>
                        </div>

                        <!-- New Password Field -->
                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-bold mb-2">
                                <i class="fas fa-lock me-2 text-success"></i>New Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-key text-success"></i>
                                </span>
                                <input asp-for="NewPassword" type="password" class="form-control border-start-0"
                                       placeholder="Enter new password" required
                                       pattern=".{6,}" title="Password must be at least 6 characters long"
                                       autocomplete="new-password">
                                <button type="button" class="btn btn-outline-secondary border-start-0"
                                        onclick="togglePasswordVisibility('NewPassword')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="form-text text-muted mt-1">Must be at least 6 characters</div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>

                            <!-- Password Strength Indicator -->
                            <div class="mt-3" id="passwordStrengthContainer">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Password strength:</small>
                                    <span id="passwordStrength" class="badge bg-secondary">None</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold mb-2">
                                <i class="fas fa-lock me-2 text-success"></i>Confirm New Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-key text-success"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0"
                                       placeholder="Confirm new password" required
                                       autocomplete="new-password">
                                <button type="button" class="btn btn-outline-secondary border-start-0"
                                        onclick="togglePasswordVisibility('ConfirmPassword')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="form-text text-muted mt-1">Re-enter your new password</div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div id="passwordMatch" class="mt-2 small" style="display: none;">
                                <i class="fas fa-check-circle text-success me-1"></i>
                                <span class="text-success">Passwords match</span>
                            </div>
                            <div id="passwordMismatch" class="mt-2 small" style="display: none;">
                                <i class="fas fa-times-circle text-danger me-1"></i>
                                <span class="text-danger">Passwords do not match</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold" id="submitBtn">
                                <i class="fas fa-check-circle me-2"></i>Reset Password
                            </button>
                        </div>

                        <!-- Back to Login -->
                        <div class="text-center pt-3 border-top">
                            <a asp-action="Login" class="text-success text-decoration-none fw-medium">
                                <i class="fas fa-arrow-left me-1"></i>Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('resetPasswordForm');
            const newPasswordInput = document.getElementById('NewPassword');
            const confirmPasswordInput = document.getElementById('ConfirmPassword');
            const passwordMatch = document.getElementById('passwordMatch');
            const passwordMismatch = document.getElementById('passwordMismatch');
            const submitBtn = document.getElementById('submitBtn');

            // Initialize password strength
            updatePasswordStrength('');
            validatePasswordMatch();

            // Real-time password validation
            if (newPasswordInput && confirmPasswordInput) {
                // Password strength tracking
                newPasswordInput.addEventListener('input', function() {
                    const password = this.value;
                    updatePasswordStrength(password);
                    validatePasswordMatch();
                });

                // Confirm password tracking
                confirmPasswordInput.addEventListener('input', validatePasswordMatch);

                function validatePasswordMatch() {
                    const password = newPasswordInput.value;
                    const confirmPassword = confirmPasswordInput.value;

                    if (password && confirmPassword) {
                        if (password === confirmPassword) {
                            passwordMatch.style.display = 'block';
                            passwordMismatch.style.display = 'none';
                            confirmPasswordInput.classList.remove('is-invalid');
                            confirmPasswordInput.classList.add('is-valid');
                        } else {
                            passwordMatch.style.display = 'none';
                            passwordMismatch.style.display = 'block';
                            confirmPasswordInput.classList.remove('is-valid');
                            confirmPasswordInput.classList.add('is-invalid');
                        }
                    } else {
                        passwordMatch.style.display = 'none';
                        passwordMismatch.style.display = 'none';
                        confirmPasswordInput.classList.remove('is-valid', 'is-invalid');
                    }
                }

                function updatePasswordStrength(password) {
                    let strength = 0;
                    let percentage = 0;

                    if (password.length >= 6) {
                        strength++;
                        percentage += 20;
                    }
                    if (password.length >= 8) {
                        strength++;
                        percentage += 20;
                    }
                    if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                        strength++;
                        percentage += 20;
                    }
                    if (/[0-9]/.test(password)) {
                        strength++;
                        percentage += 20;
                    }
                    if (/[^A-Za-z0-9]/.test(password)) {
                        strength++;
                        percentage += 20;
                    }

                    const indicator = document.getElementById('passwordStrength');
                    const bar = document.getElementById('passwordStrengthBar');

                    if (indicator && bar) {
                        const labels = ['Very Weak', 'Weak', 'Fair', 'Good', 'Strong', 'Very Strong'];
                        const colors = ['danger', 'warning', 'info', 'primary', 'success', 'success'];

                        indicator.textContent = labels[strength] || 'None';
                        indicator.className = `badge bg-${colors[strength] || 'secondary'}`;

                        bar.style.width = percentage + '%';
                        bar.className = `progress-bar bg-${colors[strength] || 'secondary'}`;

                        // Show/hide strength indicator
                        const container = document.getElementById('passwordStrengthContainer');
                        if (container) {
                            container.style.display = password ? 'block' : 'none';
                        }
                    }
                }
            }

            // Form submission handling
            if (form) {
                form.addEventListener('submit', function(e) {
                    const password = newPasswordInput.value;
                    const confirmPassword = confirmPasswordInput.value;

                    // Validate passwords match
                    if (password !== confirmPassword) {
                        e.preventDefault();
                        showAlert('Passwords do not match. Please make sure both passwords are identical.', 'danger');
                        return;
                    }

                    // Validate password length
                    if (password.length < 6) {
                        e.preventDefault();
                        showAlert('Password must be at least 6 characters long.', 'danger');
                        return;
                    }

                    // Show loading state
                    if (submitBtn) {
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Resetting Password...';
                        submitBtn.disabled = true;
                    }
                });
            }

            // Auto-focus on new password field
            if (newPasswordInput) {
                newPasswordInput.focus();
            }

            // Check for success message and redirect
            checkForSuccessRedirect();
        });

        // Password visibility toggle
        function togglePasswordVisibility(fieldId) {
            const field = document.getElementById(fieldId);
            if (field) {
                const type = field.type === 'password' ? 'text' : 'password';
                field.type = type;

                const icon = field.nextElementSibling.querySelector('i');
                if (icon) {
                    icon.className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
                }
            }
        }

        // Show alert function
        function showAlert(message, type) {
            const alertContainer = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className = `alert alert-${type} alert-dismissible fade show`;
            alert.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            alertContainer.prepend(alert);

            // Auto-remove after 5 seconds
            setTimeout(() => {
                if (alert.parentNode) {
                    alert.remove();
                }
            }, 5000);
        }

        // Check for success and redirect
        function checkForSuccessRedirect() {
            const successAlert = document.querySelector('.alert-success');
            if (successAlert && successAlert.textContent.includes('successfully')) {
                // Wait 3 seconds then redirect to home
                setTimeout(() => {
                    window.location.href = '/Home/Home';
                }, 3000);
            }
        }
    </script>

    <style>
        .card {
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(40, 167, 69, 0.1);
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            border-bottom: none;
        }

        .form-control {
            border-radius: 0 10px 10px 0;
            padding: 0.75rem 1rem;
            border: 2px solid #e9ecef;
            border-left: none;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: #28a745;
                box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.15);
            }

        .input-group-text {
            background-color: #f8f9fa;
            border: 2px solid #e9ecef;
            border-right: none;
            border-radius: 10px 0 0 10px;
        }

        .btn-success {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            border-radius: 10px;
            font-weight: 600;
            padding: 0.75rem;
            transition: all 0.3s;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
            }

            .btn-success:disabled {
                opacity: 0.7;
                transform: none;
                box-shadow: none;
            }

        .btn-outline-secondary {
            border: 2px solid #e9ecef;
            border-left: none;
            border-radius: 0 10px 10px 0;
            color: #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #f8f9fa;
                border-color: #dee2e6;
                color: #6c757d;
            }

        .alert {
            border-radius: 10px;
            border: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .progress {
            border-radius: 10px;
            background-color: #f8f9fa;
        }

        .progress-bar {
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        .is-valid {
            border-color: #28a745 !important;
        }

        .is-invalid {
            border-color: #dc3545 !important;
        }

        .border-top {
            border-top: 1px solid rgba(0,0,0,0.1) !important;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .card-body {
                padding: 1.5rem !important;
            }

            .container {
                padding-left: 15px;
                padding-right: 15px;
            }
        }
    </style>
}