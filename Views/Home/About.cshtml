@{
    ViewData["Title"] = "About TasteShare - Share Your Culinary Creations";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">About TasteShare</h1>
                <p class="lead">Where food lovers unite to share, discover, and celebrate culinary creativity</p>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <!-- Our Story Section -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <h2 class="display-6 fw-bold text-success mb-4">Our Story</h2>
            <p class="lead mb-4">
                TasteShare was born from a simple idea: great recipes deserve to be shared. What started as a small community of food enthusiasts has grown into a vibrant platform where home cooks, professional chefs, and food lovers from around the world connect through their passion for cooking.
            </p>
            <p class="mb-4">
                Founded in 2025, our mission has always been to create a space where everyone feels empowered to share their culinary creations, learn from others, and build meaningful connections through food.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="about-image-placeholder rounded-3">
                <i class="fas fa-utensils text-muted" style="font-size: 8rem;"></i>
            </div>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row mb-5">
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-bullseye text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Our Mission</h4>
                    <p class="text-muted">
                        To democratize culinary knowledge by providing a platform where anyone can share, discover, and learn from diverse food cultures and cooking techniques from around the world.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-eye text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Our Vision</h4>
                    <p class="text-muted">
                        To become the world's most inclusive and trusted culinary community, bridging cultures and generations through the universal language of food.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-5">
            <h2 class="display-6 fw-bold text-success">Why Choose TasteShare?</h2>
            <p class="lead text-muted">Discover what makes our community special</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon mb-3">
                    <i class="fas fa-share-alt text-success" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold mb-3">Share Your Creations</h5>
                <p class="text-muted">
                    Upload your favorite recipes with photos, step-by-step instructions, and personal tips. Your culinary masterpieces can inspire others worldwide.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon mb-3">
                    <i class="fas fa-heart text-success" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold mb-3">Community Feedback</h5>
                <p class="text-muted">
                    Receive likes, comments, and constructive feedback from fellow food enthusiasts. Build your reputation as a trusted recipe creator.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon mb-3">
                    <i class="fas fa-search text-success" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold mb-3">Discover New Recipes</h5>
                <p class="text-muted">
                    Explore thousands of recipes from diverse cuisines. Filter by category, ingredients, cooking time, and dietary preferences.
                </p>
            </div>
        </div>
    </div>


    <!-- Team Section -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-5">
            <h2 class="display-6 fw-bold text-success">Meet Our Team</h2>
            <p class="lead text-muted">The dedicated members behind TasteShare</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/Carlos.jpg" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Jessie James Carlos</h5>
                <p class="text-muted mb-2">Project Leader</p>
                <p class="small text-muted">
                    Oversees the entire development process and ensures the project stays aligned with its goals.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/Caido.JPG" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Kurt Aaron Caido</h5>
                <p class="text-muted mb-2">Documentation Lead</p>
                <p class="small text-muted">
                    Handles the preparation, organization, and completion of all written project requirements.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/Cancino.jpeg" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Tristan Orven Cancino</h5>
                <p class="text-muted mb-2">Researcher</p>
                <p class="small text-muted">
                    Gathers the necessary information, studies related systems, and supports the team with research.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/Lumido.png" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Christian Joe Lumido</h5>
                <p class="text-muted mb-2">Lead Programmer</p>
                <p class="small text-muted">
                    Designs the user interface and ensures the project is visually appealing and easy to use.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/malongIDP.jpg" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Christian Jay Malong</h5>
                <p class="text-muted mb-2">UI/UX Designer</p>
                <p class="small text-muted">
                    Develops the core system features and ensures the functionality of the entire project.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="team-card text-center">
                <div class="team-avatar mb-3">
                    <img src="/images/developers/Miranda.jpg" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                </div>
                <h5 class="fw-bold mb-1">Andrew John Miranda</h5>
                <p class="text-muted mb-2">Quality Assurance</p>
                <p class="small text-muted">
                    Tests the system, checks for errors, and ensures the project meets all requirements.
                </p>
            </div>
        </div>
    </div>


    <!-- Join Community CTA -->
    <div class="row">
        <div class="col-12">
            <div class="cta-section text-center py-5 rounded-3">
                <h2 class="display-6 fw-bold text-white mb-4">Ready to Join Our Community?</h2>
                <p class="lead text-white mb-4">Share your first recipe and start connecting with food lovers worldwide</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <a href="@Url.Action("Create", "Recipe")" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-plus me-2"></i>Create Recipe
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-light btn-lg px-4"
                           data-bs-toggle="modal"
                           data-bs-target="#registerModal">
                            <i class="fas fa-user-plus me-2"></i>Join Now
                        </a>

                    }
                    <a href="@Url.Action("PublicRecipe", "Home")" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-compass me-2"></i>Explore Recipes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        padding: 100px 0;
        margin-bottom: 50px;
    }

    .about-image-placeholder {
        background: #f8f9fa;
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px dashed #dee2e6;
    }

    .feature-card {
        padding: 2rem 1rem;
        border-radius: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }

    .feature-icon {
        color: #28a745;
    }

    .stat-card {
        padding: 1.5rem;
    }

    .stat-number {
        font-size: 2.5rem;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .team-card {
        padding: 2rem 1rem;
        border-radius: 10px;
        background: #f8f9fa;
        transition: transform 0.3s ease;
    }

        .team-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .team-avatar {
        color: #6c757d;
    }

    .cta-section {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(40, 167, 69, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .hero-section {
            padding: 60px 0;
        }

        .display-4 {
            font-size: 2.5rem;
        }

        .display-6 {
            font-size: 2rem;
        }

        .stat-number {
            font-size: 2rem;
        }
    }
</style>